# ── Tekly configuration (copy to .env for local dev) ──
# Core
ENVIRONMENT=development                 # development|staging|production|test
SECRET_KEY=dev-secret-key-change-in-production   # MUST be a strong >=32-char value in production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite+aiosqlite:///./repairos.db   # prod: postgresql+asyncpg://user:pass@host:5432/repairos

# Operational
SEED_DEMO=false                         # seed demo data on startup (dev only; ignored in production)
RUN_MIGRATIONS_ON_STARTUP=false         # dev escape hatch; production uses `alembic upgrade head`
CORS_ORIGINS=*                          # csv allowlist; explicit origins required in production
LOG_LEVEL=INFO
LOG_JSON=false                          # true in production for structured logs
TRUSTED_PROXY_HOPS=0                    # reverse proxies in front (load balancer=1); 0 ignores X-Forwarded-For

# Notifications (absent -> simulated/logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Payments (Stripe) — absent -> simulated gateway
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tekly subscription billing — Tekly's OWN Stripe account, which charges shops for Tekly.
# Not the same as STRIPE_SECRET_KEY above or a shop's own keys (those take the shop's customers'
# payments). REQUIRED in production; if set anywhere deployed, all of these must be set, and
# staging must use test-mode keys (sk_test_…). Use test mode until the company account is live.
# One global price list in USD; yearly = 10 x monthly. India and large deals are on custom pricing
# (set per shop in the /admin portal: billing mode "custom"), so there is no regional price list.
#  1. Stripe Dashboard → Product catalog: these recurring USD prices, each monthly and yearly,
#     tax behaviour "exclusive" (quantity of Shop and Pro = active locations):
#       Tekly Solo   $29/month    $290/year     (flat, quantity 1)
#       Tekly Shop   graduated tiered: monthly units 1–1 $69, 2+ $49   yearly 1–1 $690, 2+ $490
#       Tekly Pro    graduated tiered: monthly units 1–1 $129, 2+ $79  yearly 1–1 $1,290, 2+ $790
#       Tekly Shop extra team member  $4/month  $40/year  per unit (team members beyond the 8 a
#                    Shop includes, shared across its locations). Give these two prices the
#                    metadata kind=seat so the webhook can tell them apart from plan prices.
#  2. Settings → Tax: turn on Stripe Tax (origin address, registrations). Checkout sends
#     automatic_tax and collects the customer's tax ID (VAT, ABN, TRN…).
#  3. Settings → Adaptive Pricing: turn it on so shops see the price in their own currency.
#     Stripe doesn't offer Adaptive Pricing to businesses based in India; if Tekly bills from an
#     Indian entity, add currency_options to the prices instead.
#  4. Developers → Webhooks → add endpoint  https://<PUBLIC_BASE_URL>/api/billing/webhook
#     with events checkout.session.completed, customer.subscription.created,
#     customer.subscription.updated, customer.subscription.deleted, invoice.payment_failed.
#  5. Settings → Billing → Customer portal: turn on payment methods, invoices, tax IDs and
#     cancellation. (Plan switches happen in Tekly's Billing page; leave portal switching off.)
# PUBLIC_BASE_URL (below) must be set too: Checkout and the portal send shops back to it.
# Changing a list price later: create a new Stripe price and put its id here. Existing
# subscriptions keep the price they signed up on (founding customers' price lock relies on this).
STRIPE_BILLING_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_BILLING_PRICE_SOLO_MONTH=
STRIPE_BILLING_PRICE_SOLO_YEAR=
STRIPE_BILLING_PRICE_SHOP_MONTH=
STRIPE_BILLING_PRICE_SHOP_YEAR=
STRIPE_BILLING_PRICE_PRO_MONTH=
STRIPE_BILLING_PRICE_PRO_YEAR=
STRIPE_BILLING_PRICE_SHOP_SEAT_MONTH=
STRIPE_BILLING_PRICE_SHOP_SEAT_YEAR=

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox

# AI (Anthropic) — absent -> deterministic stub
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Secrets at rest (OAuth tokens, shop integration credentials). REQUIRED in production/staging.
# Comma-separated Fernet keys, newest first (rotation). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Public address of the app, e.g. https://app.tekly.com (payment links, portals, billing return URLs).
PUBLIC_BASE_URL=
