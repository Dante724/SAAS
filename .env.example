# ── Tekly configuration (copy to .env for local dev) ──
# Core
ENVIRONMENT=development                 # development|staging|production|test
SECRET_KEY=dev-secret-key-change-in-production   # MUST be a strong >=32-char value in production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite+aiosqlite:///./repairos.db   # prod: postgresql+asyncpg://user:pass@host:5432/repairos

# Operational
SEED_DEMO=false                         # seed demo data on startup (dev only; ignored in production)
RUN_MIGRATIONS_ON_STARTUP=false         # dev escape hatch; production uses `alembic upgrade head`
CORS_ORIGINS=*                          # csv allowlist; explicit origins required in production
LOG_LEVEL=INFO
LOG_JSON=false                          # true in production for structured logs
TRUSTED_PROXY_HOPS=0                    # reverse proxies in front (load balancer=1); 0 ignores X-Forwarded-For

# Notifications (absent -> simulated/logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# Payments (Stripe) — absent -> simulated gateway
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox

# AI (Anthropic) — absent -> deterministic stub
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Secrets at rest (OAuth tokens, shop integration credentials). REQUIRED in production/staging.
# Comma-separated Fernet keys, newest first (rotation). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
