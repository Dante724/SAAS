# ── Tekly configuration (copy to .env for local dev) ──
# Core
ENVIRONMENT=development                 # development|staging|production|test
SECRET_KEY=dev-secret-key-change-in-production   # MUST be a strong >=32-char value in production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite+aiosqlite:///./repairos.db   # prod/staging REQUIRE Postgres: postgresql+asyncpg://user:pass@host:5432/repairos
PUBLIC_BASE_URL=                        # REQUIRED in prod/staging: the app's https:// address. Emailed links,
                                        # pay-page returns and OAuth callbacks are built from it.

# Operational
SEED_DEMO=false                         # seed demo data on startup (dev only; ignored in production)
RUN_MIGRATIONS_ON_STARTUP=false         # dev escape hatch; production uses `alembic upgrade head`
CORS_ORIGINS=*                          # csv allowlist; explicit origins required in production
LOG_LEVEL=INFO
LOG_JSON=false                          # true in production for structured logs
TRUSTED_PROXY_HOPS=0                    # reverse proxies in front (load balancer=1); 0 ignores X-Forwarded-For
REDIS_URL=                              # REQUIRED with more than one worker/instance: shared rate-limit counters
SENTRY_DSN=                             # error tracking (strongly recommended in production)
METRICS_TOKEN=                          # bearer token for /metrics; unset = /metrics is 404 when deployed

# Notifications (absent -> printed in development; in prod/staging SMTP_HOST + SMTP_FROM are REQUIRED,
# since password reset, verification and invites go out through this account)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Aircall adapter (WS-C): off until the shop has an Aircall account. Each shop then saves its own
# webhook token in Settings -> Calls & telephony.
AIRCALL_ENABLED=false
TWILIO_WHATSAPP_FROM=

# Payments (Stripe) — absent -> simulated gateway
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                  # required when STRIPE_SECRET_KEY is set
STRIPE_SUCCESS_URL=                     # empty = back to the customer's pay page on PUBLIC_BASE_URL
STRIPE_CANCEL_URL=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=           # required when SQUARE_ACCESS_TOKEN is set

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=                       # empty = {PUBLIC_BASE_URL}/api/integrations/qbo/callback

# AI (Anthropic) — absent -> deterministic stub
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Secrets at rest (OAuth tokens, shop integration credentials). REQUIRED in production/staging.
# Comma-separated Fernet keys, newest first (rotation). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
