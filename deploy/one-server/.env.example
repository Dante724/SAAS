# Tekly one-server settings. Copy to .env on the server (chmod 600), fill in, never commit it.
# Every setting the app reads is documented in DEPLOY.md §2; these are the ones this setup needs.

# ── Mode ────────────────────────────────────────────────────────────────────
# staging first (load test, restore drill), then production for real shops.
ENVIRONMENT=staging
PUBLIC_BASE_URL=https://staging.example.com      # the tunnel's public hostname
CORS_ORIGINS=https://staging.example.com

# ── Secrets: generate on the server, see README step 4 ───────────────────────
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# ── Database / workers (defaults fit a 4 GB server) ─────────────────────────
POSTGRES_USER=tekly
POSTGRES_DB=tekly
WEB_CONCURRENCY=2

# ── Cloudflare Tunnel (Zero Trust → Networks → Tunnels → token) ─────────────
CLOUDFLARE_TUNNEL_TOKEN=

# ── Photos and files: Cloudflare R2 (S3-compatible) ─────────────────────────
MEDIA_BACKEND=s3
MEDIA_S3_BUCKET=tekly-media
MEDIA_S3_REGION=auto
AWS_ENDPOINT_URL_S3=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=                    # R2 token with Object Read & Write on tekly-media only
AWS_SECRET_ACCESS_KEY=

# ── Database backups: a separate bucket and token ───────────────────────────
BACKUP_S3_BUCKET=tekly-backups
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=              # R2 token with Object Read & Write on tekly-backups only
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=30
BACKUP_HOUR_UTC=3
BACKUP_HEARTBEAT_URL=                 # e.g. https://hc-ping.com/<uuid>: alerts if a night is missed
# Optional encryption of off-site dumps (README "Encrypted backups"):
BACKUP_AGE_RECIPIENT=

# ── Email (Resend, Amazon SES or any SMTP) ──────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ── Error tracking ──────────────────────────────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=                      # browser errors; baked in at build time by deploy.sh

# ── Subscription billing (required when ENVIRONMENT=production; test keys on staging) ──
STRIPE_BILLING_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_BILLING_PRICE_SOLO_MONTH=
STRIPE_BILLING_PRICE_SOLO_YEAR=
STRIPE_BILLING_PRICE_SHOP_MONTH=
STRIPE_BILLING_PRICE_SHOP_YEAR=
STRIPE_BILLING_PRICE_PRO_MONTH=
STRIPE_BILLING_PRICE_PRO_YEAR=
STRIPE_BILLING_PRICE_SHOP_SEAT_MONTH=
STRIPE_BILLING_PRICE_SHOP_SEAT_YEAR=
