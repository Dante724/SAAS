{
  "name": "Tekly Go",
  "short_name": "Tekly Go",
  "description": "Tekly on your phone: today's jobs, scan a label, change a status, clock in.",
  "id": "/go/",
  "start_url": "/go/today",
  "scope": "/go/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b1530",
  "theme_color": "#0b1530",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/icons/tekly-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Scan a label", "short_name": "Scan", "url": "/go/scan",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Today's jobs", "short_name": "Today", "url": "/go/today",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Clock in or out", "short_name": "Clock", "url": "/go/clock",
      "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
