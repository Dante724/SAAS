{
  "name": "tekly-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tekly React frontend — Strangler Fig migration (Option B). Backend/schema/data unchanged; calls the existing FastAPI at /api.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:uitext": "node scripts/check-ui-text.mjs",
    "e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@zxing/library": "0.21.3",
    "fflate": "0.8.3",
    "lucide-react": "^0.400.0",
    "material-symbols": "0.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "^10.4.19",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
